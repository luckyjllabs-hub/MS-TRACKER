{
  "appId": "com.mstracker.app",
  "appName": "MS Tracker",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#F4F3EF",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#F4F3EF",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body",
      "style": "LIGHT",
      "resizeOnFullScreen": true
    }
  }
}
